{
  "name": "money-game",
  "private": true,
  "scripts": {
    "build:toss": "node scripts/make-dist.mjs --toss && ait build",
    "deploy:toss": "ait deploy",
    "android:add": "node scripts/make-dist.mjs && cap add android",
    "build:android": "node scripts/make-dist.mjs && cap sync android",
    "build:aab": "cd android && gradlew.bat bundleRelease",
    "open:android": "cap open android",
    "make-key": "powershell -ExecutionPolicy Bypass -File scripts/make-upload-key.ps1",
    "icons": "node tools/android-assets.mjs && node tools/store-assets.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.0.3",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capawesome/capacitor-app-update": "^8.0.4"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.0.3",
    "@capacitor/cli": "^8.5.0",
    "sharp": "^0.35.3"
  }
}
