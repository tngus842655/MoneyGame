# 릴리스 서명 정보. gradle이 이 파일을 읽어 .aab에 서명한다.
#
# 이 파일을 직접 복사할 필요는 없다 — 아래 스크립트가 키스토어와 함께 만들어 준다.
# 비밀번호가 두 곳에서 어긋나는 실수를 막으려고 한 번에 처리한다.
#
#   powershell -ExecutionPolicy Bypass -File scripts/make-upload-key.ps1
#
# storeFile은 android/ 기준 상대 경로이고, 절대 경로도 된다.
# 이 파일(keystore.properties)과 *.keystore는 .gitignore에 있다 — 절대 커밋하지 말 것.
#
# ⚠️ 키를 잃어버리면 com.moneygame.app은 영영 업데이트할 수 없다. 반드시 백업할 것.

storeFile=moneygame-upload.keystore
storePassword=
keyAlias=moneygame
keyPassword=
